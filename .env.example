# Atlas AI - Local Development Environment Configuration
# Copy this file to .env before starting services:
#   cp .env.example .env
#
# NOTE: The credentials below are for LOCAL DEVELOPMENT ONLY.
# Do NOT use these credentials in production environments.

# Neo4j Database Configuration
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
